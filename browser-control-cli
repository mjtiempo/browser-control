#!/usr/bin/env python3
"""browser-control-cli — the command; the work is in `cli.main`."""
import os
import sys

# realpath, not __file__: the command is meant to be symlinked onto PATH, and
# the repo it points at is the code that must run.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from cli.main import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
